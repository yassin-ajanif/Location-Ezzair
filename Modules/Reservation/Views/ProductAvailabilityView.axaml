<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.Modules.Reservation.ViewModels"
             xmlns:cat="using:GestionCommerciale.Shared.Helpers"
             x:Class="GestionCommerciale.Modules.Reservation.Views.ProductAvailabilityView"
             x:Name="AvailRoot"
             x:DataType="vm:ProductAvailabilityViewModel"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*" Margin="4">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>

      <WrapPanel Orientation="Horizontal">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8">
          <TextBlock Text="{Binding LblProduct}" VerticalAlignment="Center" Opacity="0.75"/>
          <AutoCompleteBox MinWidth="320" MaxWidth="480"
                           MinimumPrefixLength="1" MaxDropDownHeight="320"
                           Watermark="{Binding WmProduct}"
                           ItemsSource="{Binding SearchResults}"
                           ItemFilter="{Binding CatalogFilter}"
                           Text="{Binding SearchText, Mode=TwoWay}"
                           SelectedItem="{Binding ProductPick, Mode=TwoWay}"
                           VerticalAlignment="Center">
            <AutoCompleteBox.ValueMemberBinding>
              <Binding Path="DisplayLabel"/>
            </AutoCompleteBox.ValueMemberBinding>
            <AutoCompleteBox.ItemTemplate>
              <DataTemplate DataType="cat:DocumentCatalogItem">
                <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap"/>
              </DataTemplate>
            </AutoCompleteBox.ItemTemplate>
          </AutoCompleteBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8">
          <TextBlock Text="{Binding LblQtyNeeded}" VerticalAlignment="Center" Opacity="0.75"/>
          <NumericUpDown Value="{Binding QtyNeeded}" Minimum="1" FormatString="N0" MinWidth="90"/>
        </StackPanel>
        <Border Margin="0,0,0,8" Padding="10,6" CornerRadius="8" VerticalAlignment="Center"
                Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1"
                IsVisible="{Binding HasProduct}">
          <TextBlock Text="{Binding StockTotalLabel}" FontWeight="SemiBold" Foreground="#3730A3"/>
        </Border>
      </WrapPanel>

      <TextBlock Text="{Binding LblEmptyProduct}" Opacity="0.7" IsVisible="{Binding !HasProduct}"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,280" IsVisible="{Binding HasProduct}" Margin="0,12,0,0">
      <Border Grid.Column="0" Padding="14" Margin="0,0,12,0"
              Background="{DynamicResource CourseraSurfaceBrush}"
              BorderBrush="{DynamicResource CourseraBorderBrush}"
              BorderThickness="1" CornerRadius="12">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <Button Grid.Column="0" Content="‹" Width="36" Command="{Binding PrevMonthCommand}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
              <TextBlock Text="{Binding MonthTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button Content="{Binding LblToday}" Command="{Binding GoTodayMonthCommand}" Padding="10,4"/>
            </StackPanel>
            <Button Grid.Column="2" Content="›" Width="36" Command="{Binding NextMonthCommand}"/>
          </Grid>

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
            <Border Padding="8,4" CornerRadius="6" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1">
              <TextBlock Text="{Binding LblLegendFree}" FontSize="11" Foreground="#166534"/>
            </Border>
            <Border Padding="8,4" CornerRadius="6" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1">
              <TextBlock Text="{Binding LblLegendPartial}" FontSize="11" Foreground="#92400E"/>
            </Border>
            <Border Padding="8,4" CornerRadius="6" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1">
              <TextBlock Text="{Binding LblLegendFull}" FontSize="11" Foreground="#991B1B"/>
            </Border>
          </StackPanel>

          <Grid RowDefinitions="Auto,*">
            <ItemsControl ItemsSource="{Binding WeekdayHeaders}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontWeight="SemiBold"
                             Opacity="0.65" FontSize="12" Margin="0,0,0,8"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Stack weeks so an expanded day can grow; scroll when content exceeds the panel. -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Weeks}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="0"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:AvailabilityWeekRow">
                    <ItemsControl ItemsSource="{Binding Days}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:AvailabilityDayCell">
                          <Border Margin="3" Padding="6,5" CornerRadius="8" MinHeight="72"
                                  VerticalAlignment="Stretch"
                                  Background="{Binding Background}"
                                  BorderBrush="{Binding BorderBrush}"
                                  BorderThickness="{Binding CellBorderThickness}"
                                  Opacity="{Binding Opacity}">
                            <StackPanel Spacing="2">
                              <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding ExpandArrow}"
                                        Command="{Binding ToggleDetailsCommand}"
                                        IsVisible="{Binding IsCurrentMonth}"
                                        Padding="4,0" MinWidth="22" MinHeight="22"
                                        Background="Transparent" BorderThickness="0"
                                        FontSize="12" VerticalAlignment="Top"
                                        HorizontalContentAlignment="Center"/>
                                <TextBlock Text="{Binding DayNumber}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{Binding Foreground}" VerticalAlignment="Center"/>
                              </DockPanel>
                              <StackPanel Spacing="3" IsVisible="{Binding IsCurrentMonth}" Margin="0,2,0,0">
                                <Border Padding="5,2" CornerRadius="4" HorizontalAlignment="Left"
                                        Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1">
                                  <TextBlock Text="{Binding RestantLine}" FontSize="10" FontWeight="Bold"
                                             Foreground="#166534"/>
                                </Border>
                                <StackPanel Spacing="3" IsVisible="{Binding IsExpanded}">
                                  <Border Padding="5,2" CornerRadius="4" HorizontalAlignment="Left"
                                          Background="#E0E7FF" BorderBrush="#A5B4FC" BorderThickness="1">
                                    <TextBlock Text="{Binding DispoStockLine}" FontSize="10" FontWeight="Bold"
                                               Foreground="#3730A3"/>
                                  </Border>
                                  <Border Padding="5,2" CornerRadius="4" HorizontalAlignment="Left"
                                          Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1"
                                          IsVisible="{Binding ShowSortie}">
                                    <TextBlock Text="{Binding SortieLine}" FontSize="10" FontWeight="Bold"
                                               Foreground="#991B1B"/>
                                  </Border>
                                  <Border Padding="5,2" CornerRadius="4" HorizontalAlignment="Left"
                                          Background="#DC2626" BorderBrush="#B91C1C" BorderThickness="1"
                                          IsVisible="{Binding ShowRetard}">
                                    <TextBlock Text="{Binding RetardLine}" FontSize="10" FontWeight="Bold"
                                               Foreground="White"/>
                                  </Border>
                                  <Border Padding="5,2" CornerRadius="4" HorizontalAlignment="Left"
                                          Background="#FFEDD5" BorderBrush="#FB923C" BorderThickness="1">
                                    <TextBlock Text="{Binding ReserveLine}" FontSize="10" FontWeight="Bold"
                                               Foreground="#9A3412"/>
                                  </Border>
                                </StackPanel>
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding LblOverdueTitle}" FontWeight="SemiBold"
                       IsVisible="{Binding HasOverdueBookings}"/>
            <ItemsControl ItemsSource="{Binding OverdueBookings}" IsVisible="{Binding HasOverdueBookings}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:AvailabilityBookingRow">
                  <Button Classes="dash-alert-item"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Padding="0" Margin="0"
                          Command="{Binding #AvailRoot.DataContext.OpenBookingCommand}"
                          CommandParameter="{Binding}">
                    <Panel>
                      <Border Padding="10,8" CornerRadius="8"
                              Background="#DC2626" BorderBrush="#B91C1C" BorderThickness="1"
                              IsVisible="{Binding ShowAsBonSortie}">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" FontSize="12"
                                     TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Detail}" Foreground="White" Opacity="0.9" FontSize="11"/>
                        </StackPanel>
                      </Border>
                      <Border Padding="10,8" CornerRadius="8"
                              Background="#EA580C" BorderBrush="#C2410C" BorderThickness="1"
                              IsVisible="{Binding ShowAsSoft}">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" FontSize="12"
                                     TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Detail}" Foreground="White" Opacity="0.9" FontSize="11"/>
                        </StackPanel>
                      </Border>
                    </Panel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="{Binding LblBookings}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding LblNoBookings}" Opacity="0.65" IsVisible="{Binding !HasBookings}"/>
            <ItemsControl ItemsSource="{Binding Bookings}" IsVisible="{Binding HasBookings}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:AvailabilityBookingRow">
                  <Button Classes="dash-alert-item"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Padding="0" Margin="0"
                          Command="{Binding #AvailRoot.DataContext.OpenBookingCommand}"
                          CommandParameter="{Binding}">
                    <Border Padding="10,8" CornerRadius="8"
                            Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1E3A5F" FontSize="12"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Foreground="#1E3A5F" Opacity="0.8" FontSize="11"/>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
