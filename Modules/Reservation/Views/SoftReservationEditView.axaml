<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.Modules.Reservation.ViewModels"
             xmlns:m="using:GestionCommerciale.Modules.Tiers.Models"
             xmlns:cat="using:GestionCommerciale.Shared.Helpers"
             x:Class="GestionCommerciale.Modules.Reservation.Views.SoftReservationEditView"
             x:Name="ThisView"
             x:DataType="vm:SoftReservationEditViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding BtnBack}" Command="{Binding BackCommand}"/>
        <Button Content="{Binding BtnSave}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditable}"/>
        <Button Content="{Binding BtnToBonSortie}" Command="{Binding ToBonSortieCommand}"/>
      </StackPanel>
      <Border Background="{DynamicResource CourseraSurfaceBrush}" CornerRadius="8,8,0,0" Padding="10,8">
        <Border.ContextMenu>
          <ContextMenu Opening="OnHeaderContextMenuOpening">
            <MenuItem Header="{Binding MenuDelete}" Command="{Binding RemoveReservationCommand}"/>
          </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="{Binding Numero}" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border Padding="6,2"
                    Background="{DynamicResource CourseraPrimaryBrush}"
                    BorderBrush="{DynamicResource CourseraPrimaryHoverBrush}"
                    BorderThickness="1" CornerRadius="4"
                    IsVisible="{Binding HasBonSortieLabel}" Cursor="Hand" Tapped="OnBonSortieChipTapped" VerticalAlignment="Center">
              <TextBlock Text="{Binding BonSortieLabel}" FontSize="11" FontWeight="Bold" Foreground="White"/>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding LblStatut}" Opacity="0.7" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding StatutOptions}"
                        SelectedItem="{Binding SelectedStatutOption}"
                        MinWidth="140"
                        IsEnabled="{Binding CanEditStatut}"
                        VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:SoftReservationStatutOption">
                    <TextBlock Text="{Binding Label}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Border Padding="10,4"
                      CornerRadius="4"
                      BorderThickness="1"
                      Background="{Binding StatutChipBackground}"
                      BorderBrush="{Binding StatutChipBorder}"
                      VerticalAlignment="Center"
                      IsVisible="{Binding !CanEditStatut}">
                <TextBlock Text="{Binding StatutLabel}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{Binding StatutChipForeground}"/>
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding LblCaution}" Opacity="0.7" VerticalAlignment="Center"/>
              <NumericUpDown Value="{Binding Caution}" Minimum="0" FormatString="N2"
                             MinWidth="110" MaxWidth="130" VerticalAlignment="Center"
                             IsEnabled="{Binding IsEditable}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding LblRemise}" Opacity="0.7" VerticalAlignment="Center"/>
              <NumericUpDown Value="{Binding RemiseGlobale}" Minimum="0" Maximum="100" FormatString="N2"
                             MinWidth="90" MaxWidth="110" VerticalAlignment="Center"
                             IsEnabled="{Binding IsEditable}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,24,0">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding LblClient}" VerticalAlignment="Center" Opacity="0.7"/>
            <AutoCompleteBox Width="260"
                             MinimumPrefixLength="1" MaxDropDownHeight="320"
                             Watermark="{Binding WmClientSearch}"
                             ItemsSource="{Binding Clients}"
                             ItemFilter="{Binding PartyAutocompleteFilter}"
                             SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                             IsEnabled="{Binding IsEditable}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left">
              <AutoCompleteBox.ValueMemberBinding>
                <Binding Path="Nom"/>
              </AutoCompleteBox.ValueMemberBinding>
              <AutoCompleteBox.ItemTemplate>
                <DataTemplate DataType="m:Tiers">
                  <TextBlock Text="{Binding Nom}"/>
                </DataTemplate>
              </AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="24">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="{Binding LblDateDebut}" Opacity="0.7" VerticalAlignment="Center"/>
              <CalendarDatePicker SelectedDate="{Binding DateDebut}"
                                  SelectedDateFormat="Custom"
                                  CustomDateFormatString="dd/MM/yyyy"
                                  Watermark="jj/mm/aaaa"
                                  IsEnabled="{Binding IsEditable}"
                                  VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="{Binding LblDateFin}" Opacity="0.7" VerticalAlignment="Center"/>
              <CalendarDatePicker SelectedDate="{Binding DateFinPrevue}"
                                  SelectedDateFormat="Custom"
                                  CustomDateFormatString="dd/MM/yyyy"
                                  Watermark="jj/mm/aaaa"
                                  IsEnabled="{Binding IsEditable}"
                                  VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="10" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="{Binding LblDate}" Opacity="0.7" VerticalAlignment="Center"/>
            <CalendarDatePicker SelectedDate="{Binding Date}"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="dd/MM/yyyy"
                                Watermark="jj/mm/aaaa"
                                IsEnabled="{Binding IsEditable}"
                                VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding LblAddProduct}" VerticalAlignment="Center" Opacity="0.7"/>
        <AutoCompleteBox MinWidth="360" MaxWidth="520" VerticalAlignment="Center"
                         MinimumPrefixLength="1" MaxDropDownHeight="320"
                         Watermark="{Binding WmAddProduct}"
                         ItemsSource="{Binding AddLineSearchResults}"
                         ItemFilter="{Binding CatalogAutocompleteFilter}"
                         cat:DocumentCatalogAutoComplete.ClearTextAfterPick="True"
                         Text="{Binding AddLineSearchText, Mode=TwoWay}"
                         SelectedItem="{Binding AddLineCatalogPick, Mode=TwoWay}"
                         IsEnabled="{Binding IsEditable}">
          <AutoCompleteBox.ValueMemberBinding>
            <Binding Path="Reference"/>
          </AutoCompleteBox.ValueMemberBinding>
          <AutoCompleteBox.ItemTemplate>
            <DataTemplate DataType="cat:DocumentCatalogItem">
              <TextBlock TextWrapping="Wrap" Text="{Binding DisplayLabel}"/>
            </DataTemplate>
          </AutoCompleteBox.ItemTemplate>
        </AutoCompleteBox>
        <Button Content="{Binding BtnRemoveLine}" Command="{Binding RemoveSelectedLineCommand}" IsEnabled="{Binding IsEditable}"/>
      </StackPanel>

      <TextBlock Text="{Binding LblProduitsSection}" FontWeight="SemiBold"/>

      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid MinWidth="880" RowDefinitions="Auto,*">
          <Border Grid.Row="0" BorderBrush="{DynamicResource CourseraBorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0"
                  Background="{DynamicResource CourseraSurfaceMutedBrush}" Padding="8,8">
            <Grid ColumnDefinitions="100,*,80,90,70,70,90,90">
              <TextBlock Grid.Column="0" Text="{Binding LblDocColRef}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" Text="{Binding LblDocColDesignation}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="2" Text="{Binding LblDocColQte}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="{DynamicResource CourseraPrimaryBrush}"/>
              <TextBlock Grid.Column="3" Text="{Binding LblDocColPuHt}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="4" Text="{Binding LblDocColRemise}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="5" Text="{Binding LblDocColTva}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="6" Text="{Binding LblDocColMontantHt}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="7" Text="{Binding LblDocColMontantTtc}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding ProduitLignes}" SelectedItem="{Binding SelectedProduitLine}" MinHeight="160"
                   BorderThickness="1" BorderBrush="{DynamicResource CourseraBorderBrush}" CornerRadius="0,0,8,8"
                   Background="{DynamicResource CourseraSurfaceBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:SoftReservationProduitLineRow">
                <Border Padding="6,2" BorderBrush="#18000000" BorderThickness="0,0,0,1">
                  <Grid MinHeight="34" ColumnDefinitions="100,*,80,90,70,70,90,90">
                    <TextBlock Grid.Column="0" Text="{Binding Reference}" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <TextBox Grid.Column="1" Text="{Binding Designation}" VerticalAlignment="Center" Margin="0,0,8,0"
                             IsEnabled="{Binding #ThisView.((vm:SoftReservationEditViewModel)DataContext).IsEditable}"/>
                    <NumericUpDown Grid.Column="2" Value="{Binding Quantite}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Background="{Binding QteBackground}"
                                   BorderBrush="{Binding QteBorder}"
                                   Foreground="{Binding QteForeground}"
                                   IsEnabled="{Binding #ThisView.((vm:SoftReservationEditViewModel)DataContext).IsEditable}"/>
                    <NumericUpDown Grid.Column="3" Value="{Binding PrixUnitaireHt}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   IsEnabled="{Binding #ThisView.((vm:SoftReservationEditViewModel)DataContext).IsEditable}"/>
                    <NumericUpDown Grid.Column="4" Value="{Binding Remise}" Minimum="0" Maximum="100" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   IsEnabled="{Binding #ThisView.((vm:SoftReservationEditViewModel)DataContext).IsEditable}"/>
                    <NumericUpDown Grid.Column="5" Value="{Binding TauxTva}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   IsEnabled="{Binding #ThisView.((vm:SoftReservationEditViewModel)DataContext).IsEditable}"/>
                    <TextBlock Grid.Column="6" Text="{Binding MontantHt, StringFormat={}{0:N2}}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="7" Text="{Binding MontantTtc, StringFormat={}{0:N2}}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" FontWeight="SemiBold"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </ScrollViewer>

      <TextBlock Text="{Binding LblServicesSection}" FontWeight="SemiBold" Margin="0,8,0,0"/>

      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid MinWidth="880" RowDefinitions="Auto,*">
          <Border Grid.Row="0" BorderBrush="{DynamicResource CourseraBorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0"
                  Background="{DynamicResource CourseraSurfaceMutedBrush}" Padding="8,8">
            <Grid ColumnDefinitions="100,*,80,90,70,70,90,90">
              <TextBlock Grid.Column="0" Text="{Binding LblDocColRef}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" Text="{Binding LblDocColDesignation}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="2" Text="{Binding LblDocColQteService}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="3" Text="{Binding LblDocColPuHt}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="4" Text="{Binding LblDocColRemise}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="5" Text="{Binding LblDocColTva}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="6" Text="{Binding LblDocColMontantHt}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="7" Text="{Binding LblDocColMontantTtc}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding ServiceLignes}" SelectedItem="{Binding SelectedServiceLine}" MinHeight="120"
                   BorderThickness="1" BorderBrush="{DynamicResource CourseraBorderBrush}" CornerRadius="0,0,8,8"
                   Background="{DynamicResource CourseraSurfaceBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:SoftReservationServiceLineRow">
                <Border Padding="6,2" BorderBrush="#18000000" BorderThickness="0,0,0,1">
                  <Grid MinHeight="34" ColumnDefinitions="100,*,80,90,70,70,90,90">
                    <TextBlock Grid.Column="0" Text="{Binding Reference}" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <TextBox Grid.Column="1" Text="{Binding Designation}" VerticalAlignment="Center" Margin="0,0,8,0"
                             IsEnabled="{Binding #ThisView.((vm:SoftReservationEditViewModel)DataContext).IsEditable}"/>
                    <NumericUpDown Grid.Column="2" Value="{Binding Quantite}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   IsEnabled="{Binding #ThisView.((vm:SoftReservationEditViewModel)DataContext).IsEditable}"/>
                    <NumericUpDown Grid.Column="3" Value="{Binding PrixUnitaireHt}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   IsEnabled="{Binding #ThisView.((vm:SoftReservationEditViewModel)DataContext).IsEditable}"/>
                    <NumericUpDown Grid.Column="4" Value="{Binding Remise}" Minimum="0" Maximum="100" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   IsEnabled="{Binding #ThisView.((vm:SoftReservationEditViewModel)DataContext).IsEditable}"/>
                    <NumericUpDown Grid.Column="5" Value="{Binding TauxTva}" Minimum="0" FormatString="N2"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   IsEnabled="{Binding #ThisView.((vm:SoftReservationEditViewModel)DataContext).IsEditable}"/>
                    <TextBlock Grid.Column="6" Text="{Binding MontantHt, StringFormat={}{0:N2}}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="7" Text="{Binding MontantTtc, StringFormat={}{0:N2}}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" FontWeight="SemiBold"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </ScrollViewer>

      <Grid Margin="0,8,0,0" ColumnDefinitions="*,16,Auto">
        <TextBox Grid.Column="0"
                 Watermark="{Binding LblNote}"
                 Text="{Binding Note}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="88"
                 VerticalContentAlignment="Top"
                 VerticalAlignment="Stretch"
                 IsEnabled="{Binding IsEditable}"/>
        <Border Grid.Column="2"
                Padding="14,10"
                MinWidth="220"
                VerticalAlignment="Top"
                Background="#EEF2FF"
                BorderBrush="#C7D2FE"
                BorderThickness="1"
                CornerRadius="6"
                BoxShadow="0 1 4 0 #18000000">
          <StackPanel Spacing="6" HorizontalAlignment="Right">
            <TextBlock Text="{Binding LblTotals}" FontSize="11" Opacity="0.65" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding TotalHtLabel}" FontSize="13" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding TotalTvaLabel}" FontSize="13" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding TotalTtcLabel}"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#3730A3"
                       HorizontalAlignment="Right"/>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
